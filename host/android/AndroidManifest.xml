<?xml version="1.0" encoding="utf-8"?>
<!-- com.sa2recomp.app: SA2 Recompiled for Android (arm64-v8a), packaged without Gradle by
     tools/s8/android_app.py (aapt2 link sets minSdk 29, targetSdk 35 and the version).
     The game is an executable in lib/arm64-v8a/libsa2game.so, exec'd by the play screen from the
     native library folder, so the libraries are extracted at install (extractNativeLibs). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sa2recomp.app"
    android:installLocation="internalOnly">

    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- OpenSA2: the game, mods and logs live in Internal storage/OpenSA2/ (shared storage, where
         file managers can copy to it), which needs all-files access on Android 11 and later. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- The Codes screen downloads the mod loader's code list. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:extractNativeLibs="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@style/SetupTheme"
        android:requestLegacyExternalStorage="true"
        android:hardwareAccelerated="true">

        <activity android:name="com.sa2recomp.app.Sa2SetupActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.sa2recomp.app.ModsActivity" android:label="Mods"
            android:exported="true" android:launchMode="singleTask">
            <!-- GameBanana one-click install: the browser hands over an sa2mm: link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sa2mm" />
            </intent-filter>
        </activity>
        <activity android:name="com.sa2recomp.app.GbBrowseActivity" android:label="GameBanana"
            android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.sa2recomp.app.CodesActivity" android:label="Codes" android:exported="false" />
        <activity android:name="com.sa2recomp.app.CharactersActivity" android:label="Characters" android:exported="false" />
        <activity android:name="com.sa2recomp.app.SettingsActivity" android:label="Settings" android:exported="false" />
        <activity android:name="com.sa2recomp.app.TouchEditorActivity" android:label="Touch layout"
            android:exported="false" android:screenOrientation="sensorLandscape"
            android:theme="@style/PlayTheme" />

        <activity android:name="com.sa2recomp.app.Sa2Activity"
            android:label="@string/app_name"
            android:process=":play"
            android:launchMode="singleTask"
            android:exported="false"
            android:theme="@style/PlayTheme"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|fontScale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
